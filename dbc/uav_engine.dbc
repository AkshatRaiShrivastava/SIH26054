 SG_ egt_c : 0|16@1+ (1,0) [0|1200] "degC" Vector__XXX
BO_ 259 ENGINE_OIL_PRESSURE: 8 MASTER
 SG_ oil_pressure_kpa : 0|16@1+ (1,0) [0|800] "kPa" Vector__XXX
BO_ 260 ENGINE_OIL_TEMPERATURE: 8 MASTER
 SG_ oil_temperature_c : 0|16@1+ (1,0) [-40|180] "degC" Vector__XXX
